# ── Dependencies ──────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
.yarn/

# ── Vite build output ─────────────────────────────────────
# Note: public/ is Vite's static asset folder and must NOT be ignored.
dist/
dist-ssr/
*.local
.vite/

# ── Logs ──────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Tool caches / coverage ────────────────────────────────
.eslintcache
coverage/
*.lcov

# ── Environment variables / secrets ───────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ── App specific ──────────────────────────────────────────
# CVs generated or exported while testing (personal data); sample files allowed
exports/
cv-data.json
user-data.json
*.cv.pdf

# ── Editors / IDEs ────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.suo
*.sw?

# ── Operating systems ─────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Claude Code ───────────────────────────────────────────
.claude/

# IMPORTANT: a global ignore file is also used on the author's machine.
# This file is kept complete on its own so a fresh clone stays clean.
